{
	"manifest_version": 3,
	"name": "AlgoNest",
	"version": "0.1.0",
	"description": "Save accepted LeetCode submissions to your chosen GitHub repository, organized by date and problem.",
	"permissions": ["storage", "notifications"],
	"host_permissions": [
		"https://leetcode.com/*",
		"https://api.github.com/*",
		"https://github.com/*"
	],
	"background": {
		"service_worker": "scripts/background.js"
	},
	"icons": {
		"16": "images/icon.png",
		"48": "images/icon.png",
		"128": "images/icon.png"
	},
	"action": {
		"default_title": "AlgoNest",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "images/icon.png",
			"48": "images/icon.png",
			"128": "images/icon.png"
		}
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": ["https://leetcode.com/*"],
			"js": ["scripts/language-config.js", "scripts/site-adapters.js", "scripts/content.js"],
			"run_at": "document_start"
		}
	]
}
