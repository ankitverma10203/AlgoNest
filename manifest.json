{
	"manifest_version": 3,
	"name": "AlgoNest",
	"version": "0.1.0",
	"description": "Commit accepted coding submissions to a configurable GitHub repository.",
	"permissions": ["storage", "notifications"],
	"host_permissions": [
		"https://leetcode.com/*",
		"https://api.github.com/*",
		"https://github.com/*"
	],
	"background": {
		"service_worker": "scripts/background.js"
	},
	"action": {
		"default_title": "AlgoNest",
		"default_popup": "options.html"
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": ["https://leetcode.com/*"],
			"js": ["scripts/site-adapters.js", "scripts/content.js"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["scripts/page-hook.js"],
			"matches": ["https://leetcode.com/*"]
		}
	]
}
